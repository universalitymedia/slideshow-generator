{
  "name": "slideshow-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && tsc -p server --noEmit && vite build && npm run build:server",
    "start": "NODE_ENV=production node dist-server/index.js",
    "preview": "vite preview",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p server --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
