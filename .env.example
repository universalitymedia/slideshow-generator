# Copy to .env.local and fill in. Never commit real values.

# Discord application: https://discord.com/developers/applications
# OAuth2 > Redirects: add {PUBLIC_URL}/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Where the browser reaches the app. Dev (Vite) default: http://localhost:5173
PUBLIC_URL=http://localhost:5173

# Long random string used to sign login cookies. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Comma separated Discord user ids that can open the admin dashboard.
# Discord: Settings > Advanced > Developer Mode, then right click a user > Copy User ID.
ADMIN_DISCORD_IDS=

# Who can sign in. Admins always can. Add anyone in this Discord server and/or on this list.
# With both empty, only admins can sign in.
DISCORD_GUILD_ID=
ALLOWED_DISCORD_IDS=
# Ids that are refused immediately, even with a session. Use it to remove someone you can't take off the server.
DENIED_DISCORD_IDS=
# Set to true only if you really want any Discord account to be able to sign in.
# ALLOW_ANY_DISCORD=true

# Local testing only: adds a "dev login" that skips Discord. Ignored when NODE_ENV=production.
# DEV_LOGIN=true

# Where styles and uploaded photos are stored. Default: ./data
# DATA_DIR=data
